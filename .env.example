# 管理员密码。不设置时首次启动会自动生成，写在 data/.admin-password 并打印到容器日志
SHUAKE_ADMIN_PASSWORD=change-me

# 对外端口
SHUAKE_PORT=8080

# 可选：凭证加密主密钥（32 字节 base64，可用 `openssl rand -base64 32` 生成）。
# 设置后数据卷被拷走也无法解密账号密码；不设置则自动生成 data/.master.key。
# 注意：一旦设置就不能更换，否则已保存的账号凭证无法解密。
# SHUAKE_MASTER_KEY=

# 可选：关闭登录验证（只在完全可信的内网使用）
# SHUAKE_AUTH=off
